rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication and identity helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isOrgMember() {
      return isSignedIn() && request.auth.token.email.lower().matches('.*@isf-argentina\\.org$');
    }

    function isRegisteredUser() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/app_users/$(userEmail())) ||
        isOrgMember()
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/app_users/$(userEmail())).data;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'admin@isf-argentina.org',
        'alevy@isf-argentina.org',
        'adanlevy@gmail.com'
      ];
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/app_users/$(userEmail())) &&
        getUserData().role == 'admin'
      );
    }

    function isColaborador() {
      return isBootstrapAdmin() || isOrgMember() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/app_users/$(userEmail())) &&
        (getUserData().role == 'user' || getUserData().role == 'admin')
      );
    }

    // Default deny for all unspecified collections and unauthenticated visitors
    match /{document=**} {
      allow read, write: if false;
    }

    // Expenses collection:
    // - Only Colaboradores and Admins can read expenses (contains sensitive financial amounts, vendors, banking info)
    // - Colaboradores can create/update their own expenses
    // - Only Admins can delete expenses or approve/pay them
    match /expenses/{expenseId} {
      allow read: if isColaborador();

      allow create: if isColaborador() && (
        isAdmin() ||
        !('submittedByEmail' in request.resource.data) ||
        request.resource.data.submittedByEmail.lower() == userEmail() ||
        ('userEmail' in request.resource.data && request.resource.data.userEmail.lower() == userEmail())
      );

      allow update: if isColaborador() && (
        isAdmin() ||
        !('submittedByEmail' in resource.data) ||
        resource.data.submittedByEmail.lower() == userEmail() ||
        ('userEmail' in resource.data && resource.data.userEmail.lower() == userEmail()) ||
        ('submittedByEmail' in request.resource.data && request.resource.data.submittedByEmail.lower() == userEmail())
      );

      allow delete: if isAdmin();
    }

    // Vendors catalog (contains sensitive banking details: CBU, Alias, CUIT):
    // - Only Colaboradores and Admins can read vendors for invoice association
    // - Colaboradores can register a new vendor during expense submission
    // - Only Admins can modify existing vendors or delete them
    match /vendors/{vendorId} {
      allow read: if isColaborador();
      allow create: if isColaborador();
      allow update, delete: if isAdmin();
    }

    // Cost centers and projects:
    // - Only Colaboradores and Admins can read cost centers
    // - Only Admins can manage cost centers
    match /cost_centers/{costCenterId} {
      allow read: if isColaborador();
      allow write: if isAdmin();
    }

    // Accounting categories:
    // - Only Colaboradores and Admins can read categories
    // - Only Admins can manage categories
    match /categories/{categoryId} {
      allow read: if isColaborador();
      allow write: if isAdmin();
    }

    // User preferences:
    // - Colaboradores and Admins can read and write preferences
    match /user_preferences/{prefId} {
      allow read, write: if isSignedIn();
    }

    // App users and role management:
    // - Only Colaboradores and Admins can read the user directory
    // - Admins can create, delete, or alter roles
    // - Colaboradores can self-register their own profile as 'user' role
    match /app_users/{userDocId} {
      allow read: if isColaborador() || (isSignedIn() && userDocId == userEmail());
      allow create: if isAdmin() || (
        isSignedIn() && userDocId == userEmail() && request.resource.data.role == 'user'
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isColaborador() &&
        (userEmail() == userDocId || (resource != null && 'email' in resource.data && resource.data.email.lower() == userEmail())) &&
        request.resource.data.role == resource.data.role
      );
    }

    // Audit logs:
    // - Admins can read full audit logs
    // - Only Colaboradores can append audit entries
    // - Only Admins can delete or alter audit history
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isColaborador();
      allow update, delete: if isAdmin();
    }

    // API usage logs:
    // - Admins can read API logs and consumption metrics
    // - Only Colaboradores can record API calls
    // - Only Admins can reset or delete logs
    match /api_usage_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isColaborador();
      allow update, delete: if isAdmin();
    }

    // System health diagnostics:
    // - Colaboradores can read and write ping telemetry
    match /system_health/{docId} {
      allow read, write: if isColaborador();
    }
  }
}
