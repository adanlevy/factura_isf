rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication and identity helpers
    function isSignedIn() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isOrgMember() {
      return isSignedIn() && request.auth.token.email.lower().matches('.*@isf-argentina[.]org$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/app_users/$(userEmail())).data;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'admin@isf-argentina.org',
        'alevy@isf-argentina.org',
        'adanlevy@gmail.com'
      ];
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/app_users/$(userEmail())) &&
        getUserData().role == 'admin'
      );
    }

    function isColaborador() {
      return isBootstrapAdmin() || isOrgMember() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/app_users/$(userEmail())) &&
        (getUserData().role == 'user' || getUserData().role == 'admin')
      );
    }

    // Default deny for all unspecified collections and unauthenticated visitors
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // Comprobantes (expenses)
    // ---------------------------------------------------------------
    // Campos de liquidación / pago: solo Administración puede escribirlos.
    function paymentFields() {
      return [
        'reimbursedAt', 'paymentConfirmedAt',
        'paymentProofFileName', 'paymentProofAt', 'paymentProofDriveUrl',
        'withholdingCertificateFileName', 'withholdingCertificateUploadedAt',
        'withholdingCertificateDriveUrl', 'withholdingCertificateSentAt',
        'bankDetailsRequestedAt'
      ];
    }

    // Campos que el dueño puede seguir actualizando en un comprobante ya pagado
    // (reemplazo de foto / estado de subida a Drive), sin tocar datos contables.
    function receiptFields() {
      return [
        'receiptFileName', 'driveFileId', 'driveUploadedFileName', 'driveFolderTarget',
        'driveFolderUrl', 'driveUploadedUrl', 'driveUploadStatus', 'driveUploadedAt', 'updatedAt'
      ];
    }

    function isExpenseOwner(data) {
      return (data.get('submittedByEmail', '') is string && data.get('submittedByEmail', '').lower() == userEmail()) ||
             (data.get('userEmail', '') is string && data.get('userEmail', '').lower() == userEmail());
    }

    function isPaidExpense(data) {
      return data.get('reimbursementStatus', '') == 'REIMBURSED';
    }

    // Un comprobante borrado deja un tombstone compartido: nunca puede volver a crearse
    // (evita que escrituras tardías, p. ej. el callback de subida a Drive, lo resuciten).
    function isTombstoned(expenseId) {
      return exists(/databases/$(database)/documents/deleted_expenses/$(expenseId));
    }

    function ownerCanUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isExpenseOwner(resource.data) &&
        // el dueño no puede cambiar de dueño (evita adueñarse de comprobantes ajenos)
        !changed.hasAny(['submittedByEmail', 'userEmail']) &&
        (
          // pendiente: puede editar datos, pero nunca liquidarlo ni tocar campos de pago
          (!isPaidExpense(resource.data) && !isPaidExpense(request.resource.data) && !changed.hasAny(paymentFields())) ||
          // pagado: solo foto / estado de Drive
          (isPaidExpense(resource.data) && changed.hasOnly(receiptFields()))
        );
    }

    match /expenses/{expenseId} {
      // Solo Colaboradores y Admins leen comprobantes (montos, proveedores, datos bancarios)
      allow read: if isColaborador();

      // Alta: un colaborador solo crea comprobantes propios, pendientes y sin datos de pago.
      // set(merge) sobre un documento borrado también es un 'create', por eso se chequea el tombstone.
      allow create: if isColaborador() && !isTombstoned(expenseId) && (
        isAdmin() || (
          isExpenseOwner(request.resource.data) &&
          !isPaidExpense(request.resource.data) &&
          !request.resource.data.keys().hasAny(paymentFields())
        )
      );

      allow update: if isColaborador() && (isAdmin() || ownerCanUpdate());

      // Baja: Admin, o el dueño mientras el comprobante no esté pagado
      allow delete: if isAdmin() || (
        isColaborador() && isExpenseOwner(resource.data) && !isPaidExpense(resource.data)
      );
    }

    // Tombstones de comprobantes borrados (se crean en el mismo batch que el borrado)
    match /deleted_expenses/{expenseId} {
      allow read: if isColaborador();
      allow create: if isColaborador() &&
        !existsAfter(/databases/$(database)/documents/expenses/$(expenseId)) &&
        request.resource.data.keys().hasOnly(['id', 'deletedAt', 'deletedBy']) &&
        request.resource.data.get('id', expenseId) == expenseId &&
        request.resource.data.get('deletedBy', '') == userEmail() &&
        (
          isAdmin() || (
            isExpenseOwner(get(/databases/$(database)/documents/expenses/$(expenseId)).data) &&
            !isPaidExpense(get(/databases/$(database)/documents/expenses/$(expenseId)).data)
          )
        );
      allow update: if false;
      // Solo un Admin puede quitar un tombstone (restauración manual)
      allow delete: if isAdmin();
    }

    // Vendors catalog (contains sensitive banking details: CBU, Alias, CUIT):
    // - Only Colaboradores and Admins can read vendors for invoice association
    // - Colaboradores can register a new vendor during expense submission
    // - Only Admins can modify existing vendors or delete them
    match /vendors/{vendorId} {
      allow read: if isColaborador();
      allow create: if isColaborador();
      allow update, delete: if isAdmin();
    }

    // Cost centers and projects:
    // - Only Colaboradores and Admins can read cost centers
    // - Only Admins can manage cost centers
    match /cost_centers/{costCenterId} {
      allow read: if isColaborador();
      allow write: if isAdmin();
    }

    // Accounting categories:
    // - Only Colaboradores and Admins can read categories
    // - Only Admins can manage categories
    match /categories/{categoryId} {
      allow read: if isColaborador();
      allow write: if isAdmin();
    }

    // User preferences:
    // - Colaboradores and Admins can read and write preferences
    match /user_preferences/{prefId} {
      allow read, write: if isSignedIn();
    }

    // Clave de documento que usaban las primeras versiones de la app (p. ej. juan_gmail_com)
    function legacyUserKey() {
      return userEmail().replace('[^a-zA-Z0-9_-]', '_');
    }

    function legacyUserDoc() {
      return get(/databases/$(database)/documents/app_users/$(legacyUserKey())).data;
    }

    // Migración de usuarios registrados con el formato viejo (cualquier dominio, p. ej. @gmail.com):
    // crean su documento canónico (ID = email) copiando EXACTAMENTE el rol que ya les asignó un admin.
    // Se exige que el email del documento viejo sea el suyo (claves como a.b@x / a_b@x colisionan).
    function isLegacyUserMigration(userDocId) {
      return isSignedIn() &&
        userDocId == userEmail() &&
        exists(/databases/$(database)/documents/app_users/$(legacyUserKey())) &&
        legacyUserDoc().get('email', '') is string &&
        legacyUserDoc().get('email', '').lower() == userEmail() &&
        legacyUserDoc().get('role', '') in ['user', 'admin'] &&
        request.resource.data.get('role', '') == legacyUserDoc().get('role', '') &&
        request.resource.data.keys().hasOnly(['email', 'name', 'picture', 'role', 'createdAt', 'updatedAt']);
    }

    // Usuarios y roles (app_users):
    // - Colaboradores y Admins leen el directorio; cada uno puede leer su propio registro
    // - Alta: Admins (cualquier dominio: @gmail.com, etc.), un miembro verificado de @isf-argentina.org
    //   registrándose a sí mismo con rol 'user', o la migración de un usuario con registro en formato viejo
    // - Auto-actualización: solo nombre/foto/fecha; nunca rol ni copia global (ccAllOutgoingEmails)
    match /app_users/{userDocId} {
      allow read: if isColaborador() ||
        (isSignedIn() && userDocId == userEmail()) ||
        // su propio registro en formato viejo (para poder migrarlo al iniciar sesión)
        (isSignedIn() && userDocId == legacyUserKey() && resource != null &&
          resource.data.get('email', '') is string && resource.data.get('email', '').lower() == userEmail());
      allow create: if isAdmin() || isLegacyUserMigration(userDocId) || (
        isOrgMember() &&
        userDocId == userEmail() &&
        request.resource.data.get('role', '') == 'user' &&
        request.resource.data.keys().hasOnly(['email', 'name', 'picture', 'role', 'createdAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isColaborador() &&
        (userEmail() == userDocId || (resource.data.get('email', '') is string && resource.data.get('email', '').lower() == userEmail())) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'picture', 'updatedAt'])
      );
    }

    // Audit logs:
    // - Admins can read full audit logs
    // - Only Colaboradores can append audit entries
    // - Only Admins can delete or alter audit history
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isColaborador();
      allow update, delete: if isAdmin();
    }

    // API usage logs:
    // - Admins can read API logs and consumption metrics
    // - Only Colaboradores can record API calls
    // - Only Admins can reset or delete logs
    match /api_usage_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isColaborador();
      allow update, delete: if isAdmin();
    }

    // System health diagnostics:
    // - Colaboradores can read and write ping telemetry
    match /system_health/{docId} {
      allow read, write: if isColaborador();
    }
  }
}
